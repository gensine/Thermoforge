{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Build Workbench",
      "type": "shell",
      "command": "cmake --build build",
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "problemMatcher": ["$gcc"]
    },
    {
      "label": "Configure CMake (Release)",
      "type": "shell",
      "command": "cmake -B build -G Ninja -DCMAKE_BUILD_TYPE=Release",
      "problemMatcher": []
    },
    {
      "label": "Run CTest Suite",
      "type": "shell",
      "command": "ctest --test-dir build --output-on-failure",
      "group": "test",
      "problemMatcher": []
    }
  ]
}
